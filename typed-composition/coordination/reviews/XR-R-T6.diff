+<!doctype html>
+<html lang="en">
+<head>
+  <meta charset="utf-8">
+  <meta name="viewport" content="width=device-width, initial-scale=1">
+  <title>Typed parent and child collection composition</title>
+  <style>
+    :root { color-scheme: light dark; font: 15px/1.5 system-ui, sans-serif; }
+    body { max-width: 112rem; margin: 1.75rem auto; padding: 0 1.25rem; }
+    h1, h2, h3 { line-height: 1.2; }
+    p { max-width: 82ch; }
+    .muted { opacity: .72; }
+    button, select, input { font: inherit; padding: .35rem .55rem; }
+    button { cursor: pointer; }
+    button:disabled, input:disabled { cursor: not-allowed; opacity: .55; }
+    #error { color: #b42318; background: #b4231815; border-left: .25rem solid currentColor; padding: .65rem .8rem; }
+    .layout { display: grid; grid-template-columns: minmax(18rem, 25rem) minmax(0, 1fr); gap: 1rem; align-items: start; }
+    .panel, .session-shell { border: 1px solid #8888; border-radius: .7rem; padding: .85rem; }
+    .control-list { display: grid; gap: .7rem; }
+    .session-control { border: 1px solid #8887; border-radius: .5rem; padding: .7rem; }
+    .session-control h3 { margin: 0 0 .4rem; }
+    .session-control p { margin: .25rem 0 .5rem; }
+    .actions, .policy-actions { display: flex; flex-wrap: wrap; gap: .45rem; align-items: center; }
+    .actions > * { flex: 1 1 auto; }
+    .roots { min-width: 0; }
+    .tree-shell { border-left: .3rem solid #6885aa; margin: .6rem 0; }
+    .tree-view { min-height: 5rem; }
+    .tree-children { border-left: 2px solid #75849a66; margin: .65rem 0 0 .55rem; padding: .1rem .1rem .1rem .8rem; }
+    .tree-view .collection, .tree-view .rows { display: grid; gap: .55rem; }
+    .tree-view .row { display: grid; gap: .35rem; border: 1px solid #8888; border-radius: .4rem; padding: .5rem; }
+    .tree-view input[type="text"] { box-sizing: border-box; width: 100%; }
+    .tree-view p { margin: 0; }
+    .policy { display: grid; gap: .45rem; border-top: 1px solid #8886; margin-top: .6rem; padding-top: .6rem; }
+    .policy label { display: grid; gap: .2rem; }
+    .policy .checkbox { display: flex; align-items: center; gap: .4rem; }
+    .inspection { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 19rem), 1fr)); gap: .6rem; }
+    pre { max-height: 24rem; overflow: auto; border: 1px solid #8885; border-radius: .4rem; padding: .6rem; white-space: pre-wrap; overflow-wrap: anywhere; }
+    .server-record { display: flex; flex-wrap: wrap; align-items: center; gap: .45rem; border: 1px solid #8885; border-radius: .4rem; margin: .4rem 0; padding: .4rem; }
+    .server-record code { flex: 1 1 16rem; overflow-wrap: anywhere; }
+    @media (max-width: 62rem) { .layout { grid-template-columns: 1fr; } }
+  </style>
+</head>
+<body>
+  <main>
+    <h1>Typed parent and child collections</h1>
+    <p>The parent sets a direct child’s title and read-only policy through the typed Go API. The child keeps its own Go-owned collection state and HTTP save lane. A saved row can be published into the parent’s Inbox, which keeps immutable Go receipts after the child is disposed.</p>
+    <p class="muted">Switch any session among DOM, React, and GoDOM. The Go snapshot is the state source; replacing a renderer keeps the session and its nested children mounted.</p>
+    <p>Live sessions: <strong id="live-count">Waiting for Go/WASM…</strong></p>
+    <p id="error" role="alert" hidden></p>
+
+    <div class="layout">
+      <aside class="panel" aria-labelledby="controls-heading">
+        <h2 id="controls-heading">Session controls</h2>
+        <p class="muted">Hold the child’s next save to see it complete while its parent has made it read-only. Read-only disables view controls and publishing, while the pending Go completion still applies.</p>
+        <div class="policy-actions">
+          <button id="recreate-child" type="button" disabled>Recreate child session</button>
+        </div>
+        <div id="session-controls" class="control-list"><p class="muted">Waiting for Go/WASM…</p></div>
+      </aside>
+
+      <section class="panel roots" aria-labelledby="family-heading">
+        <h2 id="family-heading">Parent and child views</h2>
+        <p class="muted">The child view displays the title supplied by this parent. The parent view displays its Published count, and the receipts panel below is read from the Go snapshot.</p>
+        <div id="parent-mount"></div>
+      </section>
+    </div>
+
+    <section class="panel" aria-labelledby="inspect-heading">
+      <h2 id="inspect-heading">Go snapshots and retained receipts</h2>
+      <div class="inspection">
+        <div><h3>Session tree and state</h3><pre id="snapshot-output">Waiting for sessions…</pre></div>
+        <div><h3>Parent Inbox receipts</h3><pre id="receipts-output">Waiting for Go Inbox…</pre></div>
+        <div><h3>HTTP requests</h3><div id="http-output"><p class="muted">Waiting for requests…</p></div></div>
+      </div>
+    </section>
+  </main>
+  <script src="/typed-composition/build/wasm_exec.js"></script>
+  <script type="module" src="/typed-composition/demo.mjs"></script>
+</body>
+</html>
diff --git a/typed-composition/http-lab-process.mjs b/typed-composition/http-lab-process.mjs
new file mode 100644
index 0000000..bc008fa
--- /dev/null
+++ b/typed-composition/http-lab-process.mjs
@@ -0,0 +1,150 @@
+import { spawn } from "node:child_process";
+import { createInterface } from "node:readline";
+
+function errorText(error) {
+  return error instanceof Error ? error.message : String(error);
+}
+
+function bounded(value, fallback, label) {
+  if (value === undefined) return fallback;
+  if (!Number.isInteger(value) || value < 1 || value > 60_000) {
+    throw new RangeError(`${label} must be an integer from 1 through 60000 milliseconds`);
+  }
+  return value;
+}
+
+/**
+ * Start the loopback lab and capture its exit/error promise before readiness
+ * can settle. Call close() from finally; its waits are bounded even when a
+ * failed spawn has no child process to terminate.
+ */
+export function startHTTPProcess({
+  command,
+  args = [],
+  cwd,
+  spawnImpl = spawn,
+  readinessTimeoutMs,
+  cleanupTimeoutMs,
+} = {}) {
+  if (typeof command !== "string" || command.length === 0) throw new TypeError("command must be a nonempty string");
+  if (!Array.isArray(args) || args.some((arg) => typeof arg !== "string")) throw new TypeError("args must be strings");
+  if (typeof spawnImpl !== "function") throw new TypeError("spawnImpl must be a function");
+  const readyTimeout = bounded(readinessTimeoutMs, 10_000, "readinessTimeoutMs");
+  const cleanupTimeout = bounded(cleanupTimeoutMs, 2_000, "cleanupTimeoutMs");
+
+  let child;
+  try {
+    child = spawnImpl(command, args, { cwd, stdio: ["ignore", "pipe", "pipe"] });
+  } catch (error) {
+    throw new Error(`could not spawn HTTP lab: ${errorText(error)}`, { cause: error });
+  }
+  if (!child || typeof child.once !== "function" || typeof child.kill !== "function" ||
+      !child.stdout || typeof child.stdout.on !== "function" ||
+      !child.stderr || typeof child.stderr.on !== "function") {
+    throw new TypeError("spawnImpl must return a child process with stdout, stderr, once(), and kill()");
+  }
+
+  const lines = createInterface({ input: child.stdout });
+  let stderr = "";
+  child.stderr.setEncoding?.("utf8");
+  child.stderr.on("data", (chunk) => { stderr += String(chunk); });
+
+  let exited = false;
+  let exitResult = null;
+  let spawnError = null;
+  let exitResolve;
+  const exit = new Promise((resolve) => { exitResolve = resolve; });
+  function finishExit(result) {
+    if (exited) return;
+    exited = true;
+    exitResult = result;
+    exitResolve(result);
+  }
+
+  let readySettled = false;
+  let readyResolve;
+  let readyReject;
+  let readinessTimer;
+  const ready = new Promise((resolve, reject) => {
+    readyResolve = resolve;
+    readyReject = reject;
+  });
+  function settleReady(error, value) {
+    if (readySettled) return;
+    readySettled = true;
+    clearTimeout(readinessTimer);
+    if (error) readyReject(error);
+    else readyResolve(value);
+  }
+  function readinessError(message, cause) {
+    return new Error(`HTTP lab ${message}${stderr ? `: ${stderr.trim()}` : ""}`, cause === undefined ? undefined : { cause });
+  }
+
+  child.once("exit", (code, signal) => {
+    finishExit({ kind: "exit", code, signal });
+    if (!readySettled) {
+      settleReady(readinessError(`exited before readiness (code=${code}, signal=${signal})`));
+    }
+  });
+  child.once("error", (error) => {
+    spawnError = error;
+    finishExit({ kind: "error", error });
+    if (!readySettled) settleReady(readinessError(`failed to start: ${errorText(error)}`, error));
+  });
+
+  // Real ChildProcess emits exit asynchronously, but preserve a completed
+  // state if a test double or future adapter reports it before registration.
+  if (child.exitCode !== null && child.exitCode !== undefined) {
+    finishExit({ kind: "exit", code: child.exitCode, signal: child.signalCode ?? null });
+    settleReady(readinessError(`exited before readiness (code=${child.exitCode}, signal=${child.signalCode ?? null})`));
+  } else if (child.signalCode !== null && child.signalCode !== undefined) {
+    finishExit({ kind: "exit", code: null, signal: child.signalCode });
+    settleReady(readinessError(`exited before readiness (code=null, signal=${child.signalCode})`));
+  }
+
+  lines.once("line", (line) => {
+    try {
+      const result = JSON.parse(line);
+      if (typeof result.url !== "string" || result.url.length === 0) throw new Error("readiness record has no url");
+      settleReady(null, result.url);
+    } catch (error) {
+      settleReady(readinessError(`returned invalid readiness data: ${errorText(error)}`, error));
+    }
+  });
+  if (!readySettled) {
+    readinessTimer = setTimeout(() => {
+      settleReady(readinessError(`readiness timed out after ${readyTimeout} ms`));
+    }, readyTimeout);
+  }
+
+  let closePromise = null;
+  async function close() {
+    if (closePromise) return closePromise;
+    closePromise = (async () => {
+      lines.close();
+      if (exited || spawnError) return exitResult;
+      try { child.kill("SIGTERM"); }
+      catch (error) {
+        if (!exited) return { kind: "kill-error", error };
+      }
+
+      let timer;
+      const wait = (milliseconds) => Promise.race([
+        exit,
+        new Promise((resolve) => { timer = setTimeout(() => resolve(null), milliseconds); }),
+      ]).finally(() => clearTimeout(timer));
+
+      let result = await wait(cleanupTimeout);
+      if (result) return result;
+      try { child.kill("SIGKILL"); }
+      catch (error) {
+        if (!exited) return { kind: "kill-error", error };
+      }
+      result = await wait(cleanupTimeout);
+      return result ?? { kind: "timed-out", timeoutMs: cleanupTimeout };
+    })();
+    return closePromise;
+  }
+
+  return { child, lines, ready, exit, close };
+}
