@@ -0,0 +1,335 @@
+package main
+
+// Strict JSON decoders shared by bridge tests and the native replay command.
+import (
+	"bytes"
+	"encoding/json"
+	"fmt"
+	"io"
+	"strconv"
+	"unicode/utf8"
+
+	"github.com/samuelpmahan/gondola/asyncsave"
+	"github.com/samuelpmahan/gondola/collection"
+	"github.com/samuelpmahan/gondola/composition"
+	"github.com/samuelpmahan/gondola/multisession"
+)
+
+type replayAction struct {
+	Method string            `json:"method"`
+	Args   []json.RawMessage `json:"args"`
+}
+
+func decodeReplayInput(encoded []byte) ([]replayAction, error) {
+	if !utf8.Valid(encoded) {
+		return nil, fmt.Errorf("input must contain valid Unicode")
+	}
+	fields, err := decodeExactObject(string(encoded), "actions")
+	if err != nil {
+		return nil, err
+	}
+	raw := bytes.TrimSpace(fields["actions"])
+	if len(raw) == 0 || raw[0] != '[' {
+		return nil, fmt.Errorf("field %q must be an array", "actions")
+	}
+	var actions []json.RawMessage
+	if err := json.Unmarshal(raw, &actions); err != nil || actions == nil {
+		return nil, fmt.Errorf("field %q must be an array", "actions")
+	}
+	result := make([]replayAction, len(actions))
+	for index, action := range actions {
+		decoded, err := decodeActionJSON(string(action))
+		if err != nil {
+			return nil, fmt.Errorf("action %d: %w", index, err)
+		}
+		result[index] = decoded
+	}
+	return result, nil
+}
+
+func decodeActionJSON(encoded string) (replayAction, error) {
+	fields, err := decodeExactObject(encoded, "method", "args")
+	if err != nil {
+		return replayAction{}, err
+	}
+	method, err := decodeJSONString(fields, "method")
+	if err != nil {
+		return replayAction{}, err
+	}
+	argsRaw := bytes.TrimSpace(fields["args"])
+	if len(argsRaw) == 0 || argsRaw[0] != '[' {
+		return replayAction{}, fmt.Errorf("field %q must be an array", "args")
+	}
+	var args []json.RawMessage
+	if err := json.Unmarshal(argsRaw, &args); err != nil || args == nil {
+		return replayAction{}, fmt.Errorf("field %q must be an array", "args")
+	}
+	return replayAction{Method: method, Args: args}, nil
+}
+
+func decodeStepJSON(encoded string) (collection.Step, error) {
+	fields, err := decodeExactObject(encoded, "Path", "Event", "Value", "Key")
+	if err != nil {
+		return collection.Step{}, err
+	}
+	path, err := decodeJSONString(fields, "Path")
+	if err != nil {
+		return collection.Step{}, err
+	}
+	event, err := decodeJSONString(fields, "Event")
+	if err != nil {
+		return collection.Step{}, err
+	}
+	value, err := decodeJSONString(fields, "Value")
+	if err != nil {
+		return collection.Step{}, err
+	}
+	key, err := decodeJSONString(fields, "Key")
+	if err != nil {
+		return collection.Step{}, err
+	}
+	return collection.Step{Path: path, Event: event, Value: value, Key: key}, nil
+}
+
+func decodeReplyJSON(encoded string) (asyncsave.Reply, error) {
+	fields, err := decodeExactObject(encoded, "ID", "Value", "Error")
+	if err != nil {
+		return asyncsave.Reply{}, err
+	}
+	id, err := parsePositiveSafeUint(fields["ID"], "ID")
+	if err != nil {
+		return asyncsave.Reply{}, err
+	}
+	value, err := decodeJSONString(fields, "Value")
+	if err != nil {
+		return asyncsave.Reply{}, err
+	}
+	message, err := decodeJSONString(fields, "Error")
+	if err != nil {
+		return asyncsave.Reply{}, err
+	}
+	return asyncsave.Reply{ID: id, Value: value, Error: message}, nil
+}
+
+func decodeInputsJSON(encoded string) (composition.Inputs, error) {
+	if !utf8.ValidString(encoded) || !validUnicodeEscapes([]byte(encoded)) {
+		return composition.Inputs{}, fmt.Errorf("input must contain valid Unicode")
+	}
+	fields, err := decodeExactObject(encoded, "Title", "ReadOnly")
+	if err != nil {
+		return composition.Inputs{}, err
+	}
+	title, err := decodeJSONString(fields, "Title")
+	if err != nil {
+		return composition.Inputs{}, err
+	}
+	var readOnly bool
+	if !isJSONBool(fields["ReadOnly"]) || json.Unmarshal(fields["ReadOnly"], &readOnly) != nil {
+		return composition.Inputs{}, fmt.Errorf("field %q must be a boolean", "ReadOnly")
+	}
+	return composition.Inputs{Title: title, ReadOnly: readOnly}, nil
+}
+
+// decodeExactObject rejects arrays, null, duplicate keys, missing keys,
+// unknown keys, and trailing JSON values. Duplicate matching uses decoded
+// names, so (for example) "ID" and "I\\u0044" collide.
+func decodeExactObject(encoded string, names ...string) (map[string]json.RawMessage, error) {
+	decoder := json.NewDecoder(bytes.NewBufferString(encoded))
+	first, err := decoder.Token()
+	if err != nil {
+		return nil, err
+	}
+	open, ok := first.(json.Delim)
+	if !ok || open != '{' {
+		return nil, fmt.Errorf("input must be an object")
+	}
+	allowed := make(map[string]struct{}, len(names))
+	for _, name := range names {
+		allowed[name] = struct{}{}
+	}
+	fields := make(map[string]json.RawMessage, len(names))
+	for decoder.More() {
+		token, err := decoder.Token()
+		if err != nil {
+			return nil, err
+		}
+		name, ok := token.(string)
+		if !ok {
+			return nil, fmt.Errorf("input property name must be a string")
+		}
+		if _, exists := fields[name]; exists {
+			return nil, fmt.Errorf("duplicate field %q", name)
+		}
+		if _, exists := allowed[name]; !exists {
+			return nil, fmt.Errorf("unexpected field %q", name)
+		}
+		var raw json.RawMessage
+		if err := decoder.Decode(&raw); err != nil {
+			return nil, err
+		}
+		fields[name] = raw
+	}
+	last, err := decoder.Token()
+	if err != nil {
+		return nil, err
+	}
+	close, ok := last.(json.Delim)
+	if !ok || close != '}' {
+		return nil, fmt.Errorf("input object was not closed")
+	}
+	if _, err := decoder.Token(); err != io.EOF {
+		if err == nil {
+			return nil, fmt.Errorf("trailing JSON value")
+		}
+		return nil, err
+	}
+	for _, name := range names {
+		if _, ok := fields[name]; !ok {
+			return nil, fmt.Errorf("missing field %q", name)
+		}
+	}
+	return fields, nil
+}
+
+func decodeJSONString(fields map[string]json.RawMessage, name string) (string, error) {
+	var value string
+	raw := bytes.TrimSpace(fields[name])
+	if len(raw) == 0 || raw[0] != '"' {
+		return "", fmt.Errorf("field %q must be a string", name)
+	}
+	if err := json.Unmarshal(raw, &value); err != nil {
+		return "", fmt.Errorf("field %q must be a string", name)
+	}
+	return value, nil
+}
+
+func parsePositiveSafeUint(raw json.RawMessage, name string) (uint64, error) {
+	value, err := parseSafeUint(raw, name)
+	if err != nil || value == 0 {
+		return 0, fmt.Errorf("field %q must be a positive safe integer", name)
+	}
+	return value, nil
+}
+
+func parseSafeUint(raw json.RawMessage, name string) (uint64, error) {
+	value := bytes.TrimSpace(raw)
+	if len(value) == 0 || value[0] < '0' || value[0] > '9' {
+		return 0, fmt.Errorf("field %q must be a non-negative safe integer", name)
+	}
+	for _, digit := range value {
+		if digit < '0' || digit > '9' {
+			return 0, fmt.Errorf("field %q must be a non-negative safe integer", name)
+		}
+	}
+	parsed, err := strconv.ParseUint(string(value), 10, 64)
+	if err != nil || parsed > asyncsave.MaxID || strconv.FormatUint(parsed, 10) != string(value) {
+		return 0, fmt.Errorf("field %q must be a non-negative safe integer", name)
+	}
+	return parsed, nil
+}
+
+func decodeSessionIDJSON(raw json.RawMessage, name string) (multisession.SessionID, error) {
+	value, err := parsePositiveSafeUint(raw, name)
+	if err != nil {
+		return 0, err
+	}
+	return multisession.SessionID(value), nil
+}
+
+func decodeRowIDJSON(raw json.RawMessage) (collection.RowID, error) {
+	value, err := parsePositiveSafeUint(raw, "rowID")
+	if err != nil {
+		return 0, err
+	}
+	return collection.RowID(value), nil
+}
+
+func decodeRevisionJSON(raw json.RawMessage) (uint64, error) {
+	return parseSafeUint(raw, "inputRevision")
+}
+
+func decodeStatusJSON(raw json.RawMessage) (int, error) {
+	value, err := parseSafeUint(raw, "status")
+	if err != nil || value < 100 || value > 599 {
+		return 0, fmt.Errorf("field %q must be an integer in range 100..599", "status")
+	}
+	return int(value), nil
+}
+
+func isJSONBool(raw json.RawMessage) bool {
+	trimmed := bytes.TrimSpace(raw)
+	return bytes.Equal(trimmed, []byte("true")) || bytes.Equal(trimmed, []byte("false"))
+}
+
+func validUnicodeEscapes(body []byte) bool {
+	inString := false
+	for i := 0; i < len(body); {
+		if !inString {
+			if body[i] == '"' {
+				inString = true
+			}
+			i++
+			continue
+		}
+		if body[i] == '"' {
+			inString = false
+			i++
+			continue
+		}
+		if body[i] != '\\' {
+			i++
+			continue
+		}
+		if i+1 >= len(body) {
+			return false
+		}
+		if body[i+1] != 'u' {
+			i += 2
+			continue
+		}
+		if i+6 > len(body) {
+			return false
+		}
+		code, ok := parseHex4(body[i+2 : i+6])
+		if !ok {
+			return false
+		}
+		switch {
+		case code >= 0xd800 && code <= 0xdbff:
+			if i+12 > len(body) || body[i+6] != '\\' || body[i+7] != 'u' {
+				return false
+			}
+			low, ok := parseHex4(body[i+8 : i+12])
+			if !ok || low < 0xdc00 || low > 0xdfff {
+				return false
+			}
+			i += 12
+		case code >= 0xdc00 && code <= 0xdfff:
+			return false
+		default:
+			i += 6
+		}
+	}
+	return !inString
+}
+
+func parseHex4(value []byte) (uint16, bool) {
+	if len(value) != 4 {
+		return 0, false
+	}
+	var result uint16
+	for _, digit := range value {
+		result <<= 4
+		switch {
+		case digit >= '0' && digit <= '9':
+			result |= uint16(digit - '0')
+		case digit >= 'a' && digit <= 'f':
+			result |= uint16(digit-'a') + 10
+		case digit >= 'A' && digit <= 'F':
+			result |= uint16(digit-'A') + 10
+		default:
+			return 0, false
+		}
+	}
+	return result, true
+}
diff --git a/cmd/composition-replay/main.go b/cmd/composition-replay/main.go
new file mode 100644
index 0000000..576408d
--- /dev/null
+++ b/cmd/composition-replay/main.go
@@ -0,0 +1,353 @@
+// Command composition-replay executes typed composition actions and emits one
+// complete state frame after each operation for browser/native comparison.
+package main
+
+import (
+	"encoding/json"
+	"fmt"
+	"io"
+	"os"
+
+	"github.com/samuelpmahan/gondola/collection"
+	"github.com/samuelpmahan/gondola/composition"
+	"github.com/samuelpmahan/gondola/httpwire"
+	"github.com/samuelpmahan/gondola/multisession"
+)
+
+type replayFrame struct {
+	Action replayAction     `json:"action"`
+	Result any              `json:"result"`
+	Frame  compositionFrame `json:"frame"`
+}
+
+type compositionFrame struct {
+	Tree     []multisession.SessionInfo `json:"tree"`
+	Sessions []sessionFrame             `json:"sessions"`
+	Changes  []multisession.SessionID   `json:"changes"`
+}
+
+type sessionFrame struct {
+	ID       multisession.SessionID `json:"id"`
+	Snapshot composition.Snapshot   `json:"snapshot"`
+}
+
+type replayOutput struct {
+	Frames []replayFrame `json:"frames"`
+}
+
+func main() {
+	os.Exit(run(os.Args[1:]))
+}
+
+func run(args []string) int {
+	if len(args) > 1 {
+		fmt.Fprintf(os.Stderr, "usage: %s [actions.json|-]\n", "composition-replay")
+		return 2
+	}
+	var reader io.Reader = os.Stdin
+	if len(args) == 1 && args[0] != "-" {
+		file, err := os.Open(args[0])
+		if err != nil {
+			fmt.Fprintln(os.Stderr, "composition-replay:", err)
+			return 2
+		}
+		defer file.Close()
+		reader = file
+	}
+	encoded, err := io.ReadAll(reader)
+	if err != nil {
+		fmt.Fprintln(os.Stderr, "composition-replay: read input:", err)
+		return 2
+	}
+	actions, err := decodeReplayInput(encoded)
+	if err != nil {
+		fmt.Fprintln(os.Stderr, "composition-replay: invalid input:", err)
+		return 2
+	}
+	manager := composition.NewManager()
+	frames := make([]replayFrame, 0, len(actions))
+	for _, action := range actions {
+		result := executeAction(manager, action)
+		frame, err := captureFrame(manager)
+		if err != nil {
+			fmt.Fprintln(os.Stderr, "composition-replay: capture frame:", err)
+			return 2
+		}
+		frames = append(frames, replayFrame{Action: action, Result: result, Frame: frame})
+	}
+	if err := json.NewEncoder(os.Stdout).Encode(replayOutput{Frames: frames}); err != nil {
+		fmt.Fprintln(os.Stderr, "composition-replay: encode output:", err)
+		return 2
+	}
+	return 0
+}
+
+func executeAction(manager *composition.Manager, action replayAction) any {
+	fail := func(err error) any { return map[string]string{"error": err.Error()} }
+	if err := exactActionArgs(action, expectedArity(action.Method)); err != nil {
+		return fail(err)
+	}
+	args := action.Args
+	decodeID := func(index int, name string) (multisession.SessionID, error) {
+		return decodeSessionIDJSON(args[index], name)
+	}
+	decodeString := func(index int, name string) (string, error) {
+		var value string
+		if err := json.Unmarshal(args[index], &value); err != nil || !rawStartsWith(args[index], '"') {
+			return "", fmt.Errorf("argument %d (%s) must be a string", index, name)
+		}
+		return value, nil
+	}
+	switch action.Method {
+	case "create":
+		id, err := manager.Create()
+		if err != nil {
+			return fail(err)
+		}
+		return id
+	case "createChild":
+		parent, err := decodeID(0, "parentID")
+		if err != nil {
+			return fail(err)
+		}
+		id, err := manager.CreateChild(parent)
+		if err != nil {
+			return fail(err)
+		}
+		return id
+	case "tree":
+		tree := manager.Tree()
+		if tree == nil {
+			tree = []multisession.SessionInfo{}
+		}
+		return tree
+	case "list":
+		ids := manager.List()
+		if ids == nil {
+			ids = []multisession.SessionID{}
+		}
+		return ids
+	case "snapshot":
+		id, err := decodeID(0, "sessionID")
+		if err != nil {
+			return fail(err)
+		}
+		snapshot, err := manager.Snapshot(id)
+		if err != nil {
+			return fail(err)
+		}
+		return snapshot
+	case "dispatch":
+		id, err := decodeID(0, "sessionID")
+		if err != nil {
+			return fail(err)
+		}
+		step, err := decodeStepJSON(string(args[1]))
+		if err != nil {
+			return fail(fmt.Errorf("invalid step: %w", err))
+		}
+		snapshot, err := manager.Dispatch(id, step)
+		if err != nil {
+			return fail(err)
+		}
+		return snapshot
+	case "effects":
+		id, err := decodeID(0, "sessionID")
+		if err != nil {
+			return fail(err)
+		}
+		commands, err := manager.Effects(id)
+		if err != nil {
+			return fail(err)
+		}
+		if commands == nil {
+			commands = []collection.Command{}
+		}
+		return commands
+	case "complete":
+		id, err := decodeID(0, "sessionID")
+		if err != nil {
+			return fail(err)
+		}
+		reply, err := decodeReplyJSON(string(args[1]))
+		if err != nil {
+			return fail(fmt.Errorf("invalid reply: %w", err))
+		}
+		snapshot, err := manager.Complete(id, reply)
+		if err != nil {
+			return fail(err)
+		}
+		return snapshot
+	case "audit":
+		id, err := decodeID(0, "sessionID")
+		if err != nil {
+			return fail(err)
+		}
+		outcomes, err := manager.Audit(id)
+		if err != nil {
+			return fail(err)
+		}
+		if outcomes == nil {
+			outcomes = []collection.Outcome{}
+		}
+		return outcomes
+	case "dispose":
+		id, err := decodeID(0, "sessionID")
+		if err != nil {
+			return fail(err)
+		}
+		commands, err := manager.Dispose(id)
+		if err != nil {
+			return fail(err)
+		}
+		if commands == nil {
+			commands = []collection.Command{}
+		}
+		return commands
+	case "disposeTree":
+		id, err := decodeID(0, "sessionID")
+		if err != nil {
+			return fail(err)
+		}
+		disposals, err := manager.DisposeTree(id)
+		if err != nil {
+			return fail(err)
+		}
+		if disposals == nil {
+			disposals = []multisession.Disposal{}
+		}
+		return disposals
+	case "setChildInputs":
+		parent, err := decodeID(0, "parentID")
+		if err != nil {
+			return fail(err)
+		}
+		child, err := decodeID(1, "childID")
+		if err != nil {
+			return fail(err)
+		}
+		inputs, err := decodeInputsJSON(string(args[2]))
+		if err != nil {
+			return fail(fmt.Errorf("invalid inputs: %w", err))
+		}
+		snapshot, err := manager.SetChildInputs(parent, child, inputs)
+		if err != nil {
+			return fail(err)
+		}
+		return snapshot
+	case "publish":
+		child, err := decodeID(0, "childID")
+		if err != nil {
+			return fail(err)
+		}
+		row, err := decodeRowIDJSON(args[1])
+		if err != nil {
+			return fail(err)
+		}
+		revision, err := decodeRevisionJSON(args[2])
+		if err != nil {
+			return fail(err)
+		}
+		publication, err := manager.Publish(child, row, revision)
+		if err != nil {
+			return fail(err)
+		}
+		return publication
+	case "changes":
+		ids := manager.Changes()
+		if ids == nil {
+			ids = []multisession.SessionID{}
+		}
+		return ids
+	case "encodeHTTP":
+		id, err := parsePositiveSafeUint(args[0], "requestID")
+		if err != nil {
+			return fail(err)
+		}
+		value, err := decodeString(1, "value")
+		if err != nil {
+			return fail(err)
+		}
+		body, err := httpwire.EncodeRequest(id, value)
+		if err != nil {
+			return fail(err)
+		}
+		return string(body)
+	case "decodeHTTP":
+		id, err := parsePositiveSafeUint(args[0], "requestID")
+		if err != nil {
+			return fail(err)
+		}
+		status, err := decodeStatusJSON(args[1])
+		if err != nil {
+			return fail(err)
+		}
+		body, err := decodeString(2, "body")
+		if err != nil {
+			return fail(err)
+		}
+		return httpwire.DecodeResponse(id, status, []byte(body))
+	default:
+		return fail(fmt.Errorf("unknown composition method %q", action.Method))
+	}
+}
+
+func expectedArity(method string) int {
+	switch method {
+	case "create", "tree", "list", "changes":
+		return 0
+	case "createChild", "snapshot", "effects", "audit", "dispose", "disposeTree":
+		return 1
+	case "dispatch", "complete", "encodeHTTP":
+		return 2
+	case "setChildInputs":
+		return 3
+	case "publish", "decodeHTTP":
+		return 3
+	default:
+		return -1
+	}
+}
+
+func exactActionArgs(action replayAction, arity int) error {
+	if arity < 0 {
+		return fmt.Errorf("unknown composition method %q", action.Method)
+	}
+	if len(action.Args) != arity {
+		return fmt.Errorf("%s requires exactly %d argument(s), got %d", action.Method, arity, len(action.Args))
+	}
+	return nil
+}
+
+func captureFrame(manager *composition.Manager) (compositionFrame, error) {
+	tree := manager.Tree()
+	if tree == nil {
+		tree = []multisession.SessionInfo{}
+	}
+	ids := manager.List()
+	if ids == nil {
+		ids = []multisession.SessionID{}
+	}
+	sessions := make([]sessionFrame, 0, len(ids))
+	for _, id := range ids {
+		snapshot, err := manager.Snapshot(id)
+		if err != nil {
+			return compositionFrame{}, err
+		}
+		sessions = append(sessions, sessionFrame{ID: id, Snapshot: snapshot})
+	}
+	changes := manager.Changes()
+	if changes == nil {
+		changes = []multisession.SessionID{}
+	}
+	return compositionFrame{Tree: tree, Sessions: sessions, Changes: changes}, nil
+}
+
+func rawStartsWith(raw json.RawMessage, prefix byte) bool {
+	for _, value := range raw {
+		if value != ' ' && value != '\n' && value != '\r' && value != '\t' {
+			return value == prefix
+		}
+	}
+	return false
+}
