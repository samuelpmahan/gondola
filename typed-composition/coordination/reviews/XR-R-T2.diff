diff --git a/cmd/composition-wasm/main_wasm.go b/cmd/composition-wasm/main_wasm.go
new file mode 100644
index 0000000..10b7c55
--- /dev/null
+++ b/cmd/composition-wasm/main_wasm.go
@@ -0,0 +1,483 @@
+//go:build js && wasm
+
+// Command composition-wasm exposes typed parent/child composition through the
+// exact-arity gobiComposition browser global.
+package main
+
+import (
+	"encoding/json"
+	"fmt"
+	"math"
+	"syscall/js"
+
+	"github.com/samuelpmahan/gondola/asyncsave"
+	"github.com/samuelpmahan/gondola/collection"
+	"github.com/samuelpmahan/gondola/composition"
+	"github.com/samuelpmahan/gondola/httpwire"
+	"github.com/samuelpmahan/gondola/multisession"
+)
+
+var (
+	manager       *composition.Manager
+	keepers       []js.Func
+	bridgeRunning bool
+)
+
+func main() {
+	manager = composition.NewManager()
+	api := js.Global().Get("Object").New()
+	api.Set("create", method("create", 0, func(args []js.Value) any {
+		id, err := manager.Create()
+		if err != nil {
+			return errorResult(err.Error())
+		}
+		return float64(id)
+	}))
+	api.Set("createChild", method("createChild", 1, func(args []js.Value) any {
+		parent, err := decodeSessionID(args[0])
+		if err != nil {
+			return errorResult(err.Error())
+		}
+		id, err := manager.CreateChild(parent)
+		if err != nil {
+			return errorResult(err.Error())
+		}
+		return float64(id)
+	}))
+	api.Set("tree", method("tree", 0, func(args []js.Value) any {
+		tree := manager.Tree()
+		if tree == nil {
+			tree = []multisession.SessionInfo{}
+		}
+		return toJS(tree)
+	}))
+	api.Set("list", method("list", 0, func(args []js.Value) any {
+		ids := manager.List()
+		if ids == nil {
+			ids = []multisession.SessionID{}
+		}
+		return toJS(ids)
+	}))
+	api.Set("snapshot", method("snapshot", 1, func(args []js.Value) any {
+		id, err := decodeSessionID(args[0])
+		if err != nil {
+			return errorResult(err.Error())
+		}
+		snapshot, err := manager.Snapshot(id)
+		if err != nil {
+			return errorResult(err.Error())
+		}
+		return toJS(snapshot)
+	}))
+	api.Set("dispatch", method("dispatch", 2, func(args []js.Value) any {
+		id, err := decodeSessionID(args[0])
+		if err != nil {
+			return errorResult(err.Error())
+		}
+		step, err := decodeStep(args[1])
+		if err != nil {
+			return errorResult(fmt.Sprintf("invalid step: %v", err))
+		}
+		snapshot, err := manager.Dispatch(id, step)
+		if err != nil {
+			return errorResult(err.Error())
+		}
+		return toJS(snapshot)
+	}))
+	api.Set("effects", method("effects", 1, func(args []js.Value) any {
+		id, err := decodeSessionID(args[0])
+		if err != nil {
+			return errorResult(err.Error())
+		}
+		commands, err := manager.Effects(id)
+		if err != nil {
+			return errorResult(err.Error())
+		}
+		if commands == nil {
+			commands = []collection.Command{}
+		}
+		return toJS(commands)
+	}))
+	api.Set("complete", method("complete", 2, func(args []js.Value) any {
+		id, err := decodeSessionID(args[0])
+		if err != nil {
+			return errorResult(err.Error())
+		}
+		reply, err := decodeReply(args[1])
+		if err != nil {
+			return errorResult(fmt.Sprintf("invalid reply: %v", err))
+		}
+		snapshot, err := manager.Complete(id, reply)
+		if err != nil {
+			return errorResult(err.Error())
+		}
+		return toJS(snapshot)
+	}))
+	api.Set("audit", method("audit", 1, func(args []js.Value) any {
+		id, err := decodeSessionID(args[0])
+		if err != nil {
+			return errorResult(err.Error())
+		}
+		outcomes, err := manager.Audit(id)
+		if err != nil {
+			return errorResult(err.Error())
+		}
+		if outcomes == nil {
+			outcomes = []collection.Outcome{}
+		}
+		return toJS(outcomes)
+	}))
+	api.Set("dispose", method("dispose", 1, func(args []js.Value) any {
+		id, err := decodeSessionID(args[0])
+		if err != nil {
+			return errorResult(err.Error())
+		}
+		commands, err := manager.Dispose(id)
+		if err != nil {
+			return errorResult(err.Error())
+		}
+		if commands == nil {
+			commands = []collection.Command{}
+		}
+		return toJS(commands)
+	}))
+	api.Set("disposeTree", method("disposeTree", 1, func(args []js.Value) any {
+		id, err := decodeSessionID(args[0])
+		if err != nil {
+			return errorResult(err.Error())
+		}
+		disposals, err := manager.DisposeTree(id)
+		if err != nil {
+			return errorResult(err.Error())
+		}
+		if disposals == nil {
+			disposals = []multisession.Disposal{}
+		}
+		return toJS(disposals)
+	}))
+	api.Set("setChildInputs", method("setChildInputs", 3, func(args []js.Value) any {
+		parent, err := decodeSessionID(args[0])
+		if err != nil {
+			return errorResult(err.Error())
+		}
+		child, err := decodeSessionID(args[1])
+		if err != nil {
+			return errorResult(err.Error())
+		}
+		inputs, err := decodeInputs(args[2])
+		if err != nil {
+			return errorResult(fmt.Sprintf("invalid inputs: %v", err))
+		}
+		snapshot, err := manager.SetChildInputs(parent, child, inputs)
+		if err != nil {
+			return errorResult(err.Error())
+		}
+		return toJS(snapshot)
+	}))
+	api.Set("publish", method("publish", 3, func(args []js.Value) any {
+		child, err := decodeSessionID(args[0])
+		if err != nil {
+			return errorResult(err.Error())
+		}
+		row, err := safeTypedID(args[1], "row ID")
+		if err != nil {
+			return errorResult(err.Error())
+		}
+		revision, err := safeUint(args[2], "input revision", true)
+		if err != nil {
+			return errorResult(err.Error())
+		}
+		publication, err := manager.Publish(child, collection.RowID(row), revision)
+		if err != nil {
+			return errorResult(err.Error())
+		}
+		return toJS(publication)
+	}))
+	api.Set("changes", method("changes", 0, func(args []js.Value) any {
+		ids := manager.Changes()
+		if ids == nil {
+			ids = []multisession.SessionID{}
+		}
+		return toJS(ids)
+	}))
+	api.Set("encodeHTTP", method("encodeHTTP", 2, func(args []js.Value) any {
+		id, err := safeTypedID(args[0], "request ID")
+		if err != nil {
+			return errorResult(err.Error())
+		}
+		if args[1].Type() != js.TypeString {
+			return errorResult("encodeHTTP value must be a primitive string")
+		}
+		body, err := httpwire.EncodeRequest(id, args[1].String())
+		if err != nil {
+			return errorResult(err.Error())
+		}
+		return string(body)
+	}))
+	api.Set("decodeHTTP", method("decodeHTTP", 3, func(args []js.Value) any {
+		id, err := safeTypedID(args[0], "request ID")
+		if err != nil {
+			return errorResult(err.Error())
+		}
+		status, err := safeJSInteger(args[1], 100, 599, "status")
+		if err != nil {
+			return errorResult(err.Error())
+		}
+		if args[2].Type() != js.TypeString {
+			return errorResult("decodeHTTP body must be a primitive string")
+		}
+		return toJS(httpwire.DecodeResponse(id, int(status), []byte(args[2].String())))
+	}))
+	js.Global().Set("gobiComposition", api)
+	select {}
+}
+
+func method(name string, arity int, operation func([]js.Value) any) js.Func {
+	return keep(js.FuncOf(func(this js.Value, args []js.Value) (result any) {
+		if bridgeRunning {
+			return errorResult("nested gobiComposition calls are not allowed during a bridge operation")
+		}
+		bridgeRunning = true
+		defer func() { bridgeRunning = false }()
+
+		if len(args) != arity {
+			return errorResult(fmt.Sprintf("%s requires exactly %d argument(s), got %d", name, arity, len(args)))
+		}
+		defer func() {
+			if recovered := recover(); recovered != nil {
+				result = errorResult(fmt.Sprintf("%s failed: %v", name, recovered))
+			}
+		}()
+		return operation(args)
+	}))
+}
+
+func keep(function js.Func) js.Func {
+	keepers = append(keepers, function)
+	return function
+}
+
+func decodeSessionID(value js.Value) (multisession.SessionID, error) {
+	if value.Type() != js.TypeNumber {
+		return 0, fmt.Errorf("session ID must be a primitive integer number")
+	}
+	number := value.Float()
+	if math.IsNaN(number) || math.IsInf(number, 0) || math.Trunc(number) != number || number < 1 || number > float64(multisession.MaxSessionID) {
+		return 0, fmt.Errorf("session ID must be an integer in range 1..%d", multisession.MaxSessionID)
+	}
+	return multisession.SessionID(uint64(number)), nil
+}
+
+func safeTypedID(value js.Value, name string) (uint64, error) {
+	return safeUint(value, name, false)
+}
+
+func safeUint(value js.Value, name string, allowZero bool) (uint64, error) {
+	minimum := float64(1)
+	if allowZero {
+		minimum = 0
+	}
+	number, err := safeJSInteger(value, minimum, float64(asyncsave.MaxID), name)
+	if err != nil {
+		return 0, err
+	}
+	return uint64(number), nil
+}
+
+func safeJSInteger(value js.Value, minimum, maximum float64, name string) (float64, error) {
+	if value.Type() != js.TypeNumber {
+		return 0, fmt.Errorf("%s must be a primitive integer number", name)
+	}
+	number := value.Float()
+	if math.IsNaN(number) || math.IsInf(number, 0) || math.Trunc(number) != number || number < minimum || number > maximum {
+		return 0, fmt.Errorf("%s must be an integer in range %d..%d", name, int64(minimum), int64(maximum))
+	}
+	return number, nil
+}
+
+func decodeStep(value js.Value) (step collection.Step, err error) {
+	defer recoverDecode("step", &err)
+	fields, err := exactDataFields(value, "Path", "Event", "Value", "Key")
+	if err != nil {
+		return collection.Step{}, err
+	}
+	path, err := requiredJSString(fields, "Path")
+	if err != nil {
+		return collection.Step{}, err
+	}
+	event, err := requiredJSString(fields, "Event")
+	if err != nil {
+		return collection.Step{}, err
+	}
+	input, err := requiredJSString(fields, "Value")
+	if err != nil {
+		return collection.Step{}, err
+	}
+	key, err := requiredJSString(fields, "Key")
+	if err != nil {
+		return collection.Step{}, err
+	}
+	return collection.Step{Path: path, Event: event, Value: input, Key: key}, nil
+}
+
+func decodeReply(value js.Value) (reply asyncsave.Reply, err error) {
+	defer recoverDecode("reply", &err)
+	fields, err := exactDataFields(value, "ID", "Value", "Error")
+	if err != nil {
+		return asyncsave.Reply{}, err
+	}
+	id, err := safeTypedID(fields["ID"], "reply ID")
+	if err != nil {
+		return asyncsave.Reply{}, err
+	}
+	answer, err := requiredJSString(fields, "Value")
+	if err != nil {
+		return asyncsave.Reply{}, err
+	}
+	message, err := requiredJSString(fields, "Error")
+	if err != nil {
+		return asyncsave.Reply{}, err
+	}
+	return asyncsave.Reply{ID: id, Value: answer, Error: message}, nil
+}
+
+func decodeInputs(value js.Value) (inputs composition.Inputs, err error) {
+	defer recoverDecode("inputs", &err)
+	fields, err := exactDataFields(value, "Title", "ReadOnly")
+	if err != nil {
+		return composition.Inputs{}, err
+	}
+	titleValue := fields["Title"]
+	if titleValue.Type() != js.TypeString {
+		return composition.Inputs{}, fmt.Errorf("field %q must be a primitive string", "Title")
+	}
+	if !validJSUTF16(titleValue) {
+		return composition.Inputs{}, fmt.Errorf("field %q must contain valid Unicode", "Title")
+	}
+	readOnly := fields["ReadOnly"]
+	if readOnly.Type() != js.TypeBoolean {
+		return composition.Inputs{}, fmt.Errorf("field %q must be a primitive boolean", "ReadOnly")
+	}
+	return composition.Inputs{Title: titleValue.String(), ReadOnly: readOnly.Bool()}, nil
+}
+
+func recoverDecode(name string, err *error) {
+	if recovered := recover(); recovered != nil {
+		*err = fmt.Errorf("%s fields could not be read: %v", name, recovered)
+	}
+}
+
+// exactDataFields snapshots only own data-property values. Input getters are
+// rejected without invocation; proxy traps can still run, so method() fences
+// nested calls while this schema is inspected.
+func exactDataFields(value js.Value, names ...string) (fields map[string]js.Value, err error) {
+	defer func() {
+		if recovered := recover(); recovered != nil {
+			fields = nil
+			err = fmt.Errorf("input fields could not be read: %v", recovered)
+		}
+	}()
+	if value.IsNull() || value.IsUndefined() || value.Type() != js.TypeObject {
+		return nil, fmt.Errorf("input must be an object")
+	}
+	if js.Global().Get("Array").Call("isArray", value).Bool() {
+		return nil, fmt.Errorf("input must be an object")
+	}
+	keys, err := reflectOwnKeys(value)
+	if err != nil {
+		return nil, err
+	}
+	if keys.Length() != len(names) {
+		return nil, fmt.Errorf("input must contain exactly %d own field(s)", len(names))
+	}
+	wanted := make(map[string]struct{}, len(names))
+	for _, name := range names {
+		wanted[name] = struct{}{}
+	}
+	for index := 0; index < keys.Length(); index++ {
+		key := keys.Index(index)
+		if key.Type() != js.TypeString {
+			return nil, fmt.Errorf("input field names must be strings")
+		}
+		if _, ok := wanted[key.String()]; !ok {
+			return nil, fmt.Errorf("unexpected field %q", key.String())
+		}
+		delete(wanted, key.String())
+	}
+	if len(wanted) != 0 {
+		return nil, fmt.Errorf("input is missing required fields")
+	}
+
+	fields = make(map[string]js.Value, len(names))
+	for _, name := range names {
+		descriptor, err := reflectOwnDescriptor(value, name)
+		if err != nil {
+			return nil, err
+		}
+		if descriptor.IsNull() || descriptor.IsUndefined() || descriptor.Type() != js.TypeObject {
+			return nil, fmt.Errorf("field %q must be an own data property", name)
+		}
+		if !js.Global().Get("Object").Call("hasOwn", descriptor, "value").Bool() {
+			return nil, fmt.Errorf("field %q must be an own data property", name)
+		}
+		fields[name] = descriptor.Get("value")
+	}
+	return fields, nil
+}
+
+func reflectOwnKeys(value js.Value) (keys js.Value, err error) {
+	defer func() {
+		if recovered := recover(); recovered != nil {
+			keys = js.Undefined()
+			err = fmt.Errorf("input fields could not be read: %v", recovered)
+		}
+	}()
+	return js.Global().Get("Reflect").Call("ownKeys", value), nil
+}
+
+func reflectOwnDescriptor(value js.Value, name string) (descriptor js.Value, err error) {
+	defer func() {
+		if recovered := recover(); recovered != nil {
+			descriptor = js.Undefined()
+			err = fmt.Errorf("field %q descriptor could not be read: %v", name, recovered)
+		}
+	}()
+	return js.Global().Get("Reflect").Call("getOwnPropertyDescriptor", value, name), nil
+}
+
+func requiredJSString(fields map[string]js.Value, name string) (string, error) {
+	field, ok := fields[name]
+	if !ok {
+		return "", fmt.Errorf("field %q is missing", name)
+	}
+	if field.Type() != js.TypeString {
+		return "", fmt.Errorf("field %q must be a primitive string", name)
+	}
+	return field.String(), nil
+}
+
+func validJSUTF16(value js.Value) (valid bool) {
+	defer func() {
+		if recover() != nil {
+			valid = false
+		}
+	}()
+	// encodeURIComponent throws for unpaired UTF-16 surrogates and accepts
+	// valid pairs, so no lossy JS-to-Go string conversion is needed to check.
+	js.Global().Call("encodeURIComponent", value)
+	return true
+}
+
+func toJS(value any) js.Value {
+	encoded, err := json.Marshal(value)
+	if err != nil {
+		return errorResult(fmt.Sprintf("could not encode result: %v", err))
+	}
+	return js.Global().Get("JSON").Call("parse", string(encoded))
+}
+
+func errorResult(message string) js.Value {
+	result := js.Global().Get("Object").New()
+	result.Set("error", message)
+	return result
+}
diff --git a/cmd/composition-wasm/smoke.html b/cmd/composition-wasm/smoke.html
new file mode 100644
index 0000000..d118407
--- /dev/null
+++ b/cmd/composition-wasm/smoke.html
@@ -0,0 +1,149 @@
+<!doctype html>
+<html><head><meta charset="utf-8"><title>Composition WASM bridge smoke</title></head>
+<body>
+<script src="/wasm_exec.js"></script>
+<script>
+window.__compositionSmoke = (async () => {
+  const assert = (condition, message) => { if (!condition) throw new Error(message); };
+  const isError = (value) => value && typeof value === "object" &&
+    Object.keys(value).length === 1 && Object.keys(value)[0] === "error" && typeof value.error === "string";
+  const unwrap = (value, operation) => { if (isError(value)) throw new Error(`${operation}: ${value.error}`); return value; };
+  const waitFor = async (readiness) => {
+    for (let attempt = 0; attempt < 200; attempt += 1) {
+      if (readiness()) return;
+      await new Promise((resolve) => setTimeout(resolve, 0));
+    }
+    throw new Error("Go WASM bridge did not publish within the bounded wait");
+  };
+  const go = new Go();
+  const response = await fetch("/composition.wasm");
+  if (!response.ok) throw new Error(`could not load WASM: ${response.status}`);
+  const bytes = await response.arrayBuffer();
+  const { instance } = await WebAssembly.instantiate(bytes, go.importObject);
+  void go.run(instance);
+  await waitFor(() => globalThis.gobiComposition);
+
+  const api = globalThis.gobiComposition;
+  const names = ["audit", "changes", "complete", "create", "createChild", "decodeHTTP", "dispatch",
+    "dispose", "disposeTree", "effects", "encodeHTTP", "list", "publish", "setChildInputs",
+    "snapshot", "tree"];
+  assert(Object.keys(api).sort().join(",") === names.join(","), "composition bridge method table must be exact");
+  const root = unwrap(api.create(), "create root");
+  const child = unwrap(api.createChild(root), "create child");
+  assert(root === 1 && child === 2, "IDs must be positive increasing safe integers");
+  const initial = unwrap(api.snapshot(child), "snapshot child");
+  assert(Object.keys(initial).sort().join(",") === "bindings,messages,state,tree",
+    "composition snapshot must retain the exact four-field envelope");
+
+  const inputUpdate = unwrap(api.setChildInputs(root, child, { Title: "Notebook", ReadOnly: true }), "set child inputs");
+  assert(inputUpdate.state.Inputs.Title === "Notebook" && inputUpdate.state.Inputs.ReadOnly === true &&
+    inputUpdate.state.InputRevision === 1, "typed inputs must reach the Go-owned snapshot");
+  const readonlySnapshot = JSON.stringify(unwrap(api.snapshot(child), "snapshot readonly child"));
+  const readonlyDispatch = api.dispatch(child, { Path: "0", Event: "click", Value: "", Key: "add" });
+  assert(isError(readonlyDispatch) || JSON.stringify(readonlyDispatch) === readonlySnapshot,
+    "read-only child dispatch must be rejected or suppressed by Go policy");
+
+  const beforeReentry = JSON.stringify(unwrap(api.list(), "list before reentry probes"));
+  let getterReads = 0;
+  const accessorInput = Object.defineProperty({ ReadOnly: false }, "Title", {
+    enumerable: true,
+    get() { getterReads += 1; return api.create(); },
+  });
+  assert(isError(api.setChildInputs(root, child, accessorInput)), "own accessor fields must be rejected");
+  assert(getterReads === 0, "schema validation must reject accessors without invoking them");
+
+  const inheritedValues = { Title: "prototype fallback", ReadOnly: false };
+  let ownKeysNestedCall;
+  const ownKeysProxy = new Proxy(Object.create(inheritedValues), {
+    ownKeys() {
+      ownKeysNestedCall = api.create();
+      return ["Title", "ReadOnly"];
+    },
+  });
+  assert(isError(api.setChildInputs(root, child, ownKeysProxy)),
+    "fabricated own-key names without own descriptors must be rejected");
+  assert(isError(ownKeysNestedCall), "nested bridge mutation during ownKeys inspection must be fenced");
+
+  const descriptorTarget = {};
+  Object.defineProperties(descriptorTarget, {
+    Title: { value: "ignored", configurable: true },
+    ReadOnly: { value: false, configurable: true },
+  });
+  let descriptorNestedCall;
+  const descriptorProxy = new Proxy(descriptorTarget, {
+    getOwnPropertyDescriptor(target, name) {
+      descriptorNestedCall = api.create();
+      throw new Error(`hostile descriptor trap for ${String(name)}`);
+    },
+  });
+  assert(isError(api.setChildInputs(root, child, descriptorProxy)),
+    "throwing own-descriptor traps must be contained");
+  assert(isError(descriptorNestedCall), "nested bridge mutation during descriptor inspection must be fenced");
+  assert(JSON.stringify(unwrap(api.list(), "list after reentry probes")) === beforeReentry,
+    "failed schema probes must not consume session IDs");
+
+  const beforeInvalid = JSON.stringify(unwrap(api.snapshot(child), "snapshot before malformed calls"));
+  const invalidCalls = [
+    () => api.setChildInputs(root, child, { Title: "x", ReadOnly: true, extra: undefined }),
+    () => api.setChildInputs(root, child, { Title: "x", ReadOnly: 1 }),
+    () => api.setChildInputs(root, child, { Title: "x", ReadOnly: new Boolean(true) }),
+    () => api.setChildInputs(root, child, { Title: "\uD800", ReadOnly: false }),
+    () => api.setChildInputs(root, child, Object.defineProperty(
+      { ReadOnly: false }, "Title", { enumerable: true, get() { throw new Error("hostile getter"); } })),
+    () => api.dispatch(child, { Path: "0", Event: "click", Value: "", Key: "add", extra: true }),
+    () => api.dispatch(child, { Path: "0", Event: "click", Value: "", Key: "add", [Symbol("extra")]: true }),
+    () => api.dispatch(child, Object.defineProperty(
+      { Path: "0", Event: "click", Value: "", Key: "add" }, "hidden", { value: true })),
+    () => api.dispatch(child, { Path: "0", Event: "click", Value: "", Key: new String("add") }),
+    () => api.publish(child, 1.5, 1),
+    () => api.publish(child, Number.MAX_SAFE_INTEGER + 1, 1),
+    () => api.publish(child, 1, 1.5),
+    () => api.publish(child, 1, -1),
+    () => api.complete(child, { ID: 1, Value: "late", Error: "", extra: true }),
+    () => api.complete(child, { ID: 1.5, Value: "late", Error: "" }),
+    () => api.decodeHTTP(1, 600, "{}"),
+    () => api.encodeHTTP(1, new String("value")),
+  ];
+  for (const invalid of invalidCalls) assert(isError(invalid()), "malformed composition input must be rejected");
+  const throwingProxy = new Proxy({}, { ownKeys() { throw new Error("hostile proxy"); } });
+  assert(isError(api.setChildInputs(root, child, throwingProxy)), "throwing ownKeys trap must be contained");
+  assert(JSON.stringify(unwrap(api.snapshot(child), "snapshot after malformed calls")) === beforeInvalid,
+    "invalid bridge calls must leave Go-owned composition state unchanged");
+
+  const afterErrors = unwrap(api.setChildInputs(root, child, { Title: "Still usable", ReadOnly: true }),
+    "set valid inputs after malformed calls");
+  assert(afterErrors.state.Inputs.Title === "Still usable" && afterErrors.state.InputRevision === 2,
+    "valid bridge methods must remain usable after rejected accessors and proxies");
+  const nextID = unwrap(api.create(), "create after malformed calls");
+  assert(nextID === 3 && unwrap(api.list(), "list after valid call").join(",") === "1,2,3",
+    "rejected accessors and proxy traps must not consume IDs");
+
+  const ids = [0, -1, 1.5, Number.MAX_SAFE_INTEGER + 1, "1", new Number(root)];
+  for (const id of ids) {
+    assert(isError(api.snapshot(id)) && isError(api.createChild(id)) && isError(api.disposeTree(id)),
+      "session IDs must be primitive positive safe integer numbers");
+  }
+  const arities = {
+    audit: 1, changes: 0, complete: 2, create: 0, createChild: 1, decodeHTTP: 3,
+    dispatch: 2, dispose: 1, disposeTree: 1, effects: 1, encodeHTTP: 2, list: 0,
+    publish: 3, setChildInputs: 3, snapshot: 1, tree: 0,
+  };
+  for (const [name, arity] of Object.entries(arities)) {
+    const args = Array.from({ length: arity + 1 }, () => undefined);
+    assert(isError(api[name](...args)), `${name} must reject the wrong arity`);
+  }
+
+  unwrap(api.dispose(child), "dispose child");
+  unwrap(api.dispose(root), "dispose root");
+  unwrap(api.dispose(nextID), "dispose post-probe root");
+  assert(unwrap(api.list(), "list after cleanup").length === 0, "smoke sessions must be removable");
+  return { ok: true, methodCount: names.length, readonlyInputRevision: inputUpdate.state.InputRevision,
+    malformedSchemasRejected: invalidCalls.length + 1, safeIDsRejected: ids.length,
+    exactArityMethods: Object.keys(arities).length, accessorReads: getterReads, ownKeysReentryBlocked: isError(ownKeysNestedCall),
+    descriptorReentryBlocked: isError(descriptorNestedCall), validMethodsAfterErrors: true };
+})().catch((error) => {
+  window.__compositionSmokeError = String(error?.stack ?? error);
+  throw error;
+});
+</script>
+</body></html>
