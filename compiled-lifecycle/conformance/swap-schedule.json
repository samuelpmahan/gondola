{
  "schema": "gobi.compiled-lifecycle-swap-schedule/v1",
  "profile": "swap",
  "initialBackend": "dom",
  "backends": [
    "react",
    "dom"
  ],
  "policy": "alternate-after-each-physical-click",
  "fixtureSwapEventIndex": 8,
  "fixtureSwap": {
    "from": "dom",
    "to": "react",
    "target": "root"
  }
}
