        "path": "compiled-children/coordination/rawlogs/N2-XR-FIX-INHERITED-GATE-invocation-freshness-witness.mjs",
        "attemptTimestamp": "2026-10-31T12:00:01.000Z",
        "invocationStartedAt": "2026-10-31T12:00:01.001Z",
        "producerStartedAt": "2026-10-31T12:00:01.002Z",
        "observed": "validator returned status passed although attempt timestamp precedes invocation by 1 ms"
      },
      "recommendation": "Pass invocationStartedAt into attempt-time validation and reject attempt timestamps earlier than that invocation, while retaining the startedAt bounds."
    }
